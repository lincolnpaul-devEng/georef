# Django Secrets
DJANGO_SECRET_KEY=django-insecure-georef-developer-key-change-in-production
DEBUG=True

# OpenRouter AI Vision Configuration (Gemini 2.5 Flash)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Mapbox Public Access Token (for Mapbox GL JS Satellite & 3D Terrain)
# Get your free token at: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=

# Supabase Early Access & Email Verification Database
# Table required: 'access_requests' with columns: email (text), is_approved (bool)
SUPABASE_URL=
SUPABASE_KEY=
